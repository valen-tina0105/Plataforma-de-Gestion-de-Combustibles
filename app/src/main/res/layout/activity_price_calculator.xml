<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PriceCalculatorActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tituloCalcular"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vehiculo"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        />

    <Spinner
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tipos"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:entries="@array/tipos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editarCombustible"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        />

    <EditText
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:id="@+id/combustible"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:inputType="number"
        android:hint="@string/combustible"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnCalcular"
        android:onClick="onSendCalculate"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:text="@string/btnCalcular"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/total"
        android:text="@string/total"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/actividad"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        />

    <Spinner
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/actividades"
        android:entries="@array/actividades"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnCambiar"
        android:text="@string/btnCambiar"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:onClick="onChangeActivity"
        />

</LinearLayout>